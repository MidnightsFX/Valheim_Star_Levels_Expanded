<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>StarLevelSystem</RootNamespace>
    <AssemblyName>StarLevelSystem</AssemblyName>
    <FileAlignment>512</FileAlignment>
    <Deterministic>true</Deterministic>
    <LangVersion>10</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <Optimize>false</Optimize>
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <WarningLevel>4</WarningLevel>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <Optimize>true</Optimize>
    <DebugType>pdbonly</DebugType>
    <WarningLevel>4</WarningLevel>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Releases\**" />
    <EmbeddedResource Remove="Releases\**" />
    <None Remove="Releases\**" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="assets\starlevelsystems" />
    <None Remove="Localization\Bulgarian.json" />
    <None Remove="Localization\Chinese.json" />
    <None Remove="Localization\Chinese_Trad.json" />
    <None Remove="Localization\Croatian.json" />
    <None Remove="Localization\Czech.json" />
    <None Remove="Localization\Danish.json" />
    <None Remove="Localization\Dutch.json" />
    <None Remove="Localization\English.json" />
    <None Remove="Localization\Finnish.json" />
    <None Remove="Localization\French.json" />
    <None Remove="Localization\Georgian.json" />
    <None Remove="Localization\German.json" />
    <None Remove="Localization\Greek.json" />
    <None Remove="Localization\Hindi.json" />
    <None Remove="Localization\Hungarian.json" />
    <None Remove="Localization\Icelandic.json" />
    <None Remove="Localization\Italian.json" />
    <None Remove="Localization\Japanese.json" />
    <None Remove="Localization\Korean.json" />
    <None Remove="Localization\Latvian.json" />
    <None Remove="Localization\Lithuanian.json" />
    <None Remove="Localization\Macedonian.json" />
    <None Remove="Localization\Norwegian.json" />
    <None Remove="Localization\Polish.json" />
    <None Remove="Localization\Portuguese_Brazilian.json" />
    <None Remove="Localization\Portuguese_European.json" />
    <None Remove="Localization\Romanian.json" />
    <None Remove="Localization\Russian.json" />
    <None Remove="Localization\Serbian.json" />
    <None Remove="Localization\Slovak.json" />
    <None Remove="Localization\Spanish.json" />
    <None Remove="Localization\Swedish.json" />
    <None Remove="Localization\Thai.json" />
    <None Remove="Localization\Turkish.json" />
    <None Remove="Localization\Ukrainian.json" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="assets\starlevelsystems" />
    <EmbeddedResource Include="Localization\Bulgarian.json" />
    <EmbeddedResource Include="Localization\Chinese.json" />
    <EmbeddedResource Include="Localization\Chinese_Trad.json" />
    <EmbeddedResource Include="Localization\Croatian.json" />
    <EmbeddedResource Include="Localization\Czech.json" />
    <EmbeddedResource Include="Localization\Danish.json" />
    <EmbeddedResource Include="Localization\Dutch.json" />
    <EmbeddedResource Include="Localization\English.json" />
    <EmbeddedResource Include="Localization\Finnish.json" />
    <EmbeddedResource Include="Localization\French.json" />
    <EmbeddedResource Include="Localization\Georgian.json" />
    <EmbeddedResource Include="Localization\German.json" />
    <EmbeddedResource Include="Localization\Greek.json" />
    <EmbeddedResource Include="Localization\Hindi.json" />
    <EmbeddedResource Include="Localization\Hungarian.json" />
    <EmbeddedResource Include="Localization\Icelandic.json" />
    <EmbeddedResource Include="Localization\Italian.json" />
    <EmbeddedResource Include="Localization\Japanese.json" />
    <EmbeddedResource Include="Localization\Korean.json" />
    <EmbeddedResource Include="Localization\Latvian.json" />
    <EmbeddedResource Include="Localization\Lithuanian.json" />
    <EmbeddedResource Include="Localization\Macedonian.json" />
    <EmbeddedResource Include="Localization\Norwegian.json" />
    <EmbeddedResource Include="Localization\Polish.json" />
    <EmbeddedResource Include="Localization\Portuguese_Brazilian.json" />
    <EmbeddedResource Include="Localization\Portuguese_European.json" />
    <EmbeddedResource Include="Localization\Romanian.json" />
    <EmbeddedResource Include="Localization\Russian.json" />
    <EmbeddedResource Include="Localization\Serbian.json" />
    <EmbeddedResource Include="Localization\Slovak.json" />
    <EmbeddedResource Include="Localization\Spanish.json" />
    <EmbeddedResource Include="Localization\Swedish.json" />
    <EmbeddedResource Include="Localization\Thai.json" />
    <EmbeddedResource Include="Localization\Turkish.json" />
    <EmbeddedResource Include="Localization\Ukrainian.json" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Xml.Linq" />
    <Reference Include="System.Data.DataSetExtensions" />
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.Data" />
    <Reference Include="System.Xml" />
  </ItemGroup>

  <ItemGroup>
    <None Include="app.config" />
    <None Include="packages.config" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="JotunnLib" Version="2.29.1" />
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- JotunnLib's reference list still carries assemblies that Valheim's Unity version
         dropped. Nothing here uses them, and leaving them in warns MSB3245 every build. -->
    <Reference Remove="UnityEngine.ProfilerModule" Condition="!Exists('$(VALHEIM_MANAGED)/UnityEngine.ProfilerModule.dll')" />
  </ItemGroup>

  <PropertyGroup>
    <!-- VALHEIM_MANAGED and BEPINEX_PATH are resolved in ..\Directory.Build.props, which
         is evaluated before JotunnLib's package props and so wins the "only set this if it
         is still empty" race they use. Only fill in what is still missing here. -->
    <VALHEIM_MANAGED Condition=" '$(VALHEIM_MANAGED)' == '' ">$(VALHEIM_INSTALL)/valheim_Data/Managed</VALHEIM_MANAGED>
    <BEPINEX_PATH Condition=" '$(BEPINEX_PATH)' == '' ">$(VALHEIM_INSTALL)/BepInEx</BEPINEX_PATH>
    <UNITY_FOLDER>$(SolutionDir)StarLevelUnity</UNITY_FOLDER>
  </PropertyGroup>

  <!-- Unity has to load every game assembly the prefabs' components live in, and everything
       those reference, or it refuses assembly_valheim and each vanilla component on a prefab
       becomes a missing script. Taken by pattern rather than by name so that a game update
       adding one (Deep North brought in MagicaClothV2) is picked up without editing this.
       Left out is whatever Unity or one of its packages already provides: the BCL, the engine
       modules and the package runtimes. Newtonsoft.Json, and the Burst / Collections /
       Mathematics that MagicaClothV2 needs, come from Packages/manifest.json instead, and a
       second copy here would clash with them. -->
  <Target Name="CollectUnityGameAssemblies">
    <ItemGroup>
      <UnityGameAssembly Condition="Exists('$(VALHEIM_MANAGED)')"
                         Include="$(VALHEIM_MANAGED)/*.dll"
                         Exclude="$(VALHEIM_MANAGED)/mscorlib.dll;
                                  $(VALHEIM_MANAGED)/netstandard.dll;
                                  $(VALHEIM_MANAGED)/System*.dll;
                                  $(VALHEIM_MANAGED)/Mono.*.dll;
                                  $(VALHEIM_MANAGED)/UnityEngine*.dll;
                                  $(VALHEIM_MANAGED)/Unity.*.dll;
                                  $(VALHEIM_MANAGED)/com.unity.*.dll;
                                  $(VALHEIM_MANAGED)/Autodesk.*.dll;
                                  $(VALHEIM_MANAGED)/SingularityGroup.*.dll;
                                  $(VALHEIM_MANAGED)/Newtonsoft.Json.dll" />
    </ItemGroup>
  </Target>

  <!-- A game assembly the Unity project has not seen yet gets its .meta written before the dll
       lands, with Auto Reference off. Left on, every package compiles against the game's
       global-namespace types, and assembly_utils' field-only DisplayNameAttribute then shadows
       System.ComponentModel's in Timeline and the Input System - their compile fails and the
       editor will not open. Nothing in the Unity project compiles against the game; the
       prefabs only need the assemblies loaded. An existing .meta is never touched, so the
       GUIDs the prefabs point at stay put. -->
  <Target Name="WriteUnityGameAssemblyMetas" Condition="'@(UnityGameAssembly)' != ''" Outputs="%(UnityGameAssembly.Identity)">
    <PropertyGroup>
      <_UnityMetaFile>$(UNITY_FOLDER)/Assets/Assemblies/%(UnityGameAssembly.Filename)%(UnityGameAssembly.Extension).meta</_UnityMetaFile>
      <_UnityMeta>fileFormatVersion: 2
guid: $([System.Guid]::NewGuid().ToString('N'))
PluginImporter:
  externalObjects: {}
  serializedVersion: 2
  iconMap: {}
  executionOrder: {}
  defineConstraints: []
  isPreloaded: 0
  isOverridable: 0
  isExplicitlyReferenced: 1
  validateReferences: 1
  platformData:
  - first:
      Any:
    second:
      enabled: 1
      settings: {}
  - first:
      Editor: Editor
    second:
      enabled: 0
      settings:
        DefaultValueInitialized: true
  - first:
      Windows Store Apps: WindowsStoreApps
    second:
      enabled: 0
      settings:
        CPU: AnyCPU
  userData:
  assetBundleName:
  assetBundleVariant:
</_UnityMeta>
    </PropertyGroup>
    <WriteLinesToFile Condition="!Exists('$(_UnityMetaFile)')" File="$(_UnityMetaFile)" Lines="$(_UnityMeta)" Overwrite="true" />
  </Target>

  <Target Name="CopyToUnity" DependsOnTargets="CollectUnityGameAssemblies;WriteUnityGameAssemblyMetas">
    <Message Text="Copy assemblies to Unity" Importance="high" />
    <Copy SourceFiles="$(BEPINEX_PATH)/core/BepInEx.dll" DestinationFolder="$(UNITY_FOLDER)/Assets/Assemblies" />
    <Copy SourceFiles="$(BEPINEX_PATH)/core/0Harmony.dll" DestinationFolder="$(UNITY_FOLDER)/Assets/Assemblies" />
    <Copy SourceFiles="$(BEPINEX_PATH)/core/Mono.Cecil.dll" DestinationFolder="$(UNITY_FOLDER)/Assets/Assemblies" />
    <Copy SourceFiles="$(BEPINEX_PATH)/core/MonoMod.Utils.dll" DestinationFolder="$(UNITY_FOLDER)/Assets/Assemblies" />
    <Copy SourceFiles="$(BEPINEX_PATH)/core/MonoMod.RuntimeDetour.dll" DestinationFolder="$(UNITY_FOLDER)/Assets/Assemblies" />
    <Copy SourceFiles="$(TargetDir)Jotunn.dll" DestinationFolder="$(UNITY_FOLDER)/Assets/Assemblies" />
    <!-- Both this plugin and Jotunn reference it, and the prefabs carry this plugin's components. -->
    <Copy SourceFiles="$(TargetDir)YamlDotNet.dll" DestinationFolder="$(UNITY_FOLDER)/Assets/Assemblies" />
    <Copy SourceFiles="$(TargetDir)$(TargetName).dll" DestinationFolder="$(UNITY_FOLDER)/Assets/Assemblies" />
    <Copy SourceFiles="$(TargetDir)$(TargetName).pdb" DestinationFolder="$(UNITY_FOLDER)/Assets/Assemblies" />
    <!-- mdb generation doesn't work from portable pdbs, which are the only kind supported under Linux -->
    <Copy Condition="Exists('$(TargetDir)$(TargetName).dll.mdb')" SourceFiles="$(TargetDir)$(TargetName).dll.mdb" DestinationFolder="$(UNITY_FOLDER)/Assets/Assemblies" />
    <Copy SourceFiles="@(UnityGameAssembly)" DestinationFolder="$(UNITY_FOLDER)/Assets/Assemblies" SkipUnchangedFiles="true" />

    <!-- Bundles are built for the game's own Unity, and Valheim moves to a new Unity release
         with most updates, so say so when the two drift apart. The game's version sits in
         the header of globalgamemanagers. -->
    <PropertyGroup>
      <_ValheimUnityVersion Condition="Exists('$(VALHEIM_MANAGED)/../globalgamemanagers')">$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(VALHEIM_MANAGED)/../globalgamemanagers')), '\d+\.\d+\.\d+[abfp]\d+'))</_ValheimUnityVersion>
      <_UnityProjectVersion Condition="Exists('$(UNITY_FOLDER)/ProjectSettings/ProjectVersion.txt')">$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(UNITY_FOLDER)/ProjectSettings/ProjectVersion.txt')), '(?&lt;=m_EditorVersion: )\S+'))</_UnityProjectVersion>
    </PropertyGroup>
    <Warning Condition="'$(_ValheimUnityVersion)' != '' And '$(_UnityProjectVersion)' != '' And '$(_ValheimUnityVersion)' != '$(_UnityProjectVersion)'"
             Text="Valheim now runs on Unity $(_ValheimUnityVersion) but $(UNITY_FOLDER) is on $(_UnityProjectVersion). Open it once with Unity $(_ValheimUnityVersion) to upgrade it, and rebuild the asset bundles there." />
  </Target>

  <Target Name="JotunnPostBuildTask" AfterTargets="Build">
    <CallTarget Targets="CopyToUnity" Condition="Exists('$(UNITY_FOLDER)')" />
  </Target>

  <!-- Normalized, native, with a trailing separator. Deliberately not
       $(SolutionDir): that is literally "*Undefined*" when the .csproj is built
       directly rather than through the .sln. -->
  <PropertyGroup>
    <RepoRoot>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../'))</RepoRoot>
  </PropertyGroup>

  <!-- Debug only: Release builds with DebugType=pdbonly, so there is no full pdb
       to convert and the mdb only matters for in-game Mono debugging. -->
  <Target Name="GenerateMdb" AfterTargets="Build" Condition=" '$(OS)' == 'Windows_NT' AND '$(Configuration)' == 'Debug' AND Exists('$(TargetDir)$(TargetName).pdb') ">
    <Exec Command="&quot;$(RepoRoot)libraries\Debug\pdb2mdb.exe&quot; &quot;$(TargetDir)$(TargetFileName)&quot;" />
  </Target>

  <Target Name="PreBuild" BeforeTargets="PreBuildEvent">
    <Exec Command="xcopy &quot;$(ProjectDir)\..\StarLevelUnity\AssetBundles\StandaloneWindows\starlevelsystems&quot; &quot;$(ProjectDir)assets\starlevelsystems&quot; /q /y /i&#xA;&#xA;" />
  </Target>

  <PropertyGroup>
    <BuildDependsOn>
      $(BuildDependsOn);
    </BuildDependsOn>
  </PropertyGroup>
  <!-- BEGIN mod-tools (managed block; replaced by `mod-tools setup`) -->
  <PropertyGroup>
    <RepoRoot Condition=" '$(RepoRoot)' == '' ">$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../'))</RepoRoot>
    <!-- Override in the gitignored Environment.props when the gem's bindir
         is not on the PATH that MSBuild sees. -->
    <ModTools Condition=" '$(ModTools)' == '' ">mod-tools</ModTools>
  </PropertyGroup>

  <!-- Nothing is vendored into this repo, so a machine that never installed
       the tools has no mod-tools at all. This probes for it once and warns,
       rather than failing: not having a release tool should not stop anyone
       compiling. Everything below is then conditioned on the result, so a
       machine without it skips those steps instead of failing three times
       over with "command not found" buried in Exec output. -->
  <Target Name="ModToolsGuard" BeforeTargets="Build">
    <Exec Command="$(ModTools) preflight --root &quot;$(RepoRoot).&quot;" ContinueOnError="true" IgnoreExitCode="true" StandardOutputImportance="low">
      <Output TaskParameter="ExitCode" PropertyName="ModToolsExit" />
    </Exec>
    <PropertyGroup>
      <ModToolsAvailable Condition=" '$(ModToolsExit)' == '0' ">true</ModToolsAvailable>
    </PropertyGroup>
    <Warning Condition=" '$(ModToolsAvailable)' != 'true' " Text="mod-tools is not installed on this machine, or this repo is not set up. Skipping release checks, packaging and deploy. Install it with `rake install` from a clone of the tools repo; see its SETUP.md." />
  </Target>

  <!-- After the build, not before it. `check` packages as well as checks
       now, and packaging reads the assembly the compile just produced, so
       a BeforeTargets hook would stage the previous one. The cost is that
       a bad version story is reported after the compile rather than
       instead of it; the build still fails, one step later. -->
  <Target Name="ReleaseChecks" AfterTargets="Build" Condition=" '$(ModToolsAvailable)' == 'true' AND '$(Configuration)' == 'Release' ">
    <Exec Command="$(ModTools) check --root &quot;$(RepoRoot).&quot;" />
  </Target>

  <!-- No Configuration condition, unlike the one above: every build lands
       in the test profiles, Debug and Release alike. Declared last so it
       runs after a GenerateMdb target defined earlier in this file, whose
       .mdb it copies. Does nothing unless release.yml enables deploy. -->
  <Target Name="ModToolsDeploy" AfterTargets="Build" Condition=" '$(ModToolsAvailable)' == 'true' ">
    <Exec Command="$(ModTools) deploy --root &quot;$(RepoRoot).&quot; --configuration $(Configuration)" />
  </Target>
  <!-- END mod-tools -->
</Project>