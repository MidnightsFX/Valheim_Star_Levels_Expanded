<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>StarLevelSystem</RootNamespace>
    <AssemblyName>StarLevelSystem</AssemblyName>
    <FileAlignment>512</FileAlignment>
    <Deterministic>true</Deterministic>
    <LangVersion>10</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <Optimize>false</Optimize>
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <WarningLevel>4</WarningLevel>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <Optimize>true</Optimize>
    <DebugType>pdbonly</DebugType>
    <WarningLevel>4</WarningLevel>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Releases\**" />
    <EmbeddedResource Remove="Releases\**" />
    <None Remove="Releases\**" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="assets\starlevelsystems" />
    <None Remove="Localization\Bulgarian.json" />
    <None Remove="Localization\Chinese.json" />
    <None Remove="Localization\Chinese_Trad.json" />
    <None Remove="Localization\Croatian.json" />
    <None Remove="Localization\Czech.json" />
    <None Remove="Localization\Danish.json" />
    <None Remove="Localization\Dutch.json" />
    <None Remove="Localization\English.json" />
    <None Remove="Localization\Finnish.json" />
    <None Remove="Localization\French.json" />
    <None Remove="Localization\Georgian.json" />
    <None Remove="Localization\German.json" />
    <None Remove="Localization\Greek.json" />
    <None Remove="Localization\Hindi.json" />
    <None Remove="Localization\Hungarian.json" />
    <None Remove="Localization\Icelandic.json" />
    <None Remove="Localization\Italian.json" />
    <None Remove="Localization\Japanese.json" />
    <None Remove="Localization\Korean.json" />
    <None Remove="Localization\Latvian.json" />
    <None Remove="Localization\Lithuanian.json" />
    <None Remove="Localization\Macedonian.json" />
    <None Remove="Localization\Norwegian.json" />
    <None Remove="Localization\Polish.json" />
    <None Remove="Localization\Portuguese_Brazilian.json" />
    <None Remove="Localization\Portuguese_European.json" />
    <None Remove="Localization\Romanian.json" />
    <None Remove="Localization\Russian.json" />
    <None Remove="Localization\Serbian.json" />
    <None Remove="Localization\Slovak.json" />
    <None Remove="Localization\Spanish.json" />
    <None Remove="Localization\Swedish.json" />
    <None Remove="Localization\Thai.json" />
