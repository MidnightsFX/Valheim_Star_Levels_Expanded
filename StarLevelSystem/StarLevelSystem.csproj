    <None Remove="Localization\Ukrainian.json" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="assets\starlevelsystems" />
    <EmbeddedResource Include="Localization\Bulgarian.json" />
    <EmbeddedResource Include="Localization\Chinese.json" />
    <EmbeddedResource Include="Localization\Chinese_Trad.json" />
    <EmbeddedResource Include="Localization\Croatian.json" />
    <EmbeddedResource Include="Localization\Czech.json" />
    <EmbeddedResource Include="Localization\Danish.json" />
    <EmbeddedResource Include="Localization\Dutch.json" />
    <EmbeddedResource Include="Localization\English.json" />
    <EmbeddedResource Include="Localization\Finnish.json" />
    <EmbeddedResource Include="Localization\French.json" />
    <EmbeddedResource Include="Localization\Georgian.json" />
    <EmbeddedResource Include="Localization\German.json" />
    <EmbeddedResource Include="Localization\Greek.json" />
    <EmbeddedResource Include="Localization\Hindi.json" />
    <EmbeddedResource Include="Localization\Hungarian.json" />
    <EmbeddedResource Include="Localization\Icelandic.json" />
    <EmbeddedResource Include="Localization\Italian.json" />
    <EmbeddedResource Include="Localization\Japanese.json" />
    <EmbeddedResource Include="Localization\Korean.json" />
    <EmbeddedResource Include="Localization\Latvian.json" />
    <EmbeddedResource Include="Localization\Lithuanian.json" />
